# Python bytecode from helpers/ (a run of helpers/packages.py leaves one).
__pycache__/
*.pyc

# What `helpers/packages.py build` and `publish` write when run by hand at the root, as the
# README's examples do.
/repository/
/site/

# macOS finder junk.
.DS_Store

# ruff's cache, from `ruff check` run by hand.
.ruff_cache/

# nife, checked out beside the tree by the recipe-bump workflow (or linked there by hand), and what
# building tools/manifest_note_compare against it leaves.
/nife
/tools/manifest_note_compare/target/
/tools/manifest_note_compare/Cargo.lock
